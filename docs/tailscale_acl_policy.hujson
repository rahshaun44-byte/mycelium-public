{
  "acls": [
    // 1. Mobile Nodes (Pixel 11 Pro & Galaxy S23 FE) -> Master Node (Yoga 7) HTTP/HUD Ports
    {
      "action": "accept",
      "src": ["100.64.1.18", "100.64.1.32"], // pixel-11-pro, rahshauns-s23-fe
      "dst": [
        "100.64.1.17:8000", // AMARA Biological Dashboard
        "100.64.1.17:8080", // Core API Gateway (/api/invariant, /status)
        "100.64.1.17:9050", // QuantumFlex Sovereign Mobile HUD
        "100.64.1.17:9060", // Lyceum Academic Surface (Read-Only)
        "100.64.1.17:9443"  // QuantumFlex Engine mTLS IPC
      ]
    },

    // 2. Mobile Nodes -> Worker Node (Pavilion) Monitoring UI
    {
      "action": "accept",
      "src": ["100.64.1.18", "100.64.1.32"],
      "dst": [
        "100.64.1.34:8090" // Kafka UI Stream Console
      ]
    },

    // 3. Master Node (Yoga 7) -> Worker Node (Pavilion) Stream Pipeline & Management
    {
      "action": "accept",
      "src": ["100.64.1.17"], // fedora
      "dst": [
        "100.64.1.34:9092", // Kafka KRaft Telemetry Broker
        "100.64.1.34:8090", // Kafka UI
        "100.64.1.34:22"    // Operator SSH (rocky@qf-pavilion)
      ]
    },

    // 4. Worker Node (Pavilion) -> Master Node Telemetry Ingestion
    {
      "action": "accept",
      "src": ["100.64.1.34"], // qf-pavilion-worker
      "dst": [
        "100.64.1.17:8080", // API Node Telemetry Ingestion
        "100.64.1.17:9443"  // Engine mTLS
      ]
    },

    // 5. Allow owner self-management for all devices
    {
      "action": "accept",
      "src": ["autogroup:owner"],
      "dst": ["autogroup:self:*"]
    }
  ],

  // Node Tag Owners (Optional for tag-based management)
  "tagOwners": {
    "tag:master": ["autogroup:owner"],
    "tag:worker": ["autogroup:owner"],
    "tag:mobile": ["autogroup:owner"]
  },

  // SSH Access Policy (Zero Root Direct Logins Enforced)
  "ssh": [
    {
      "action": "accept",
      "src": ["100.64.1.17"], // Only Fedora Yoga master can SSH
      "dst": ["100.64.1.34"],   // To HP Pavilion worker
      "users": ["rocky"]          // Strictly unprivileged operator; root denied
    }
  ]
}
